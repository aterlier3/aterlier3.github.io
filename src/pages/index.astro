    <script>
      const questionDialog = document.getElementById("question-dialog") as HTMLDialogElement | null;
      const questionForm = document.getElementById("question-form") as HTMLFormElement | null;

      if (questionDialog && questionForm) {
        document.querySelectorAll("[data-open-question]").forEach((btn) => {
          btn.addEventListener("click", () => questionDialog.showModal());
        });

        document.querySelectorAll("[data-close-question]").forEach((btn) => {
          btn.addEventListener("click", () => questionDialog.close());
        });

        questionDialog.addEventListener("click", (event) => {
          if (event.target === questionDialog) questionDialog.close();
        });

        questionForm.addEventListener("submit", (event) => {
          event.preventDefault();
          const data = new FormData(questionForm);
          const name = data.get("name");
          const email = data.get("email");
          const question = data.get("question");

          const subject = `Pytanie od ${name}`;
          const body = [
            `Imię i nazwisko: ${name}`,
            `E-mail: ${email}`,
            "",
            "Treść pytania:",
            String(question),
          ].join("\n");

          window.location.href = `mailto:jachimczak.klara@gmail.com?subject=${encodeURIComponent(
            subject
          )}&body=${encodeURIComponent(body)}`;

          questionDialog.close();
          questionForm.reset();
        });
      }
