    color: var(--baby-blue-deep);
    margin-bottom: 0.5rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 8vw, 6.5rem);
    font-weight: 500;
    color: var(--black);
  }

  .hero h1 em {
    color: var(--baby-blue-deep);
    font-style: normal;
    font-weight: 500;
  }

  .hero-sub {
    max-width: 46ch;
    margin: 0.5rem auto 0;
    text-align: center;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero-sub-white {
    max-width: 46ch;
    margin: 0.5rem auto 0;
    text-align: center;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: var(--ink-light);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .cta-primary {
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    transition: background 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .cta-primary:hover {
    background: var(--black-soft);
    transform: translateY(-1px);
  }

  .cta-ghost {
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .cta-ghost:hover {
    transform: translateY(-1px);
  }

  .cta-dark {
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    padding: 0.85rem 1.6rem;
    border-radius: 4px;
    font-size: 0.98rem;
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .cta-dark:hover {
    transform: translateY(-1px);
  }

  .hero :global(.keys.hero) {
    margin-top: 2.5rem;
    max-width: 640px;
    width: 100%;
  }

  .meta-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    padding: 1.25rem 0 2.5rem;
    letter-spacing: 0.02em;
  }

  /* ---------- SECTIONS (shared) ---------- */
  .section {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 6vw, 3rem);
    text-align: center;
  }

  .section--black {
    background: var(--black);
    color: var(--white);
  }

  .section--white {
    background: var(--white);
    color: var(--ink);
  }

  .section--mist {
    background: var(--mist);
    color: var(--ink-light);
  }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 500;
    text-align: center;
  }

  .section h2.accent {
    color: var(--ink-light);
  }

  .section-sub {
    text-align: center;
    max-width: 50ch;
    margin: 0.75rem auto 0;
    opacity: 0.7;
    font-size: 1rem;
  }
  .section-piano-practice {
    margin-bottom: 0;
  }

  .section-more {
    margin-top: 0;
  }
  .more-section {
    padding-top: 0;
  }
  /* ---------- OFFER NOTE ---------- */
  .offer-note {
    text-align: center;
    max-width: 50ch;
    margin: 2.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--black) 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
  }

  .offer-note strong {
    color: var(--baby-blue-deep);
    font-weight: 600;
  }

  /* ---------- PRINCIPLES / PACKAGES ---------- */
  .principles {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .principle h3 {
    font-size: 1.2rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
    color: var(--black);
  }

  .principle p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-light);
  }

  @media (max-width: 780px) {
    .principles {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* ---------- PACKAGE COMPARISON ---------- */
  .package-grid {
    max-width: 1100px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
    text-align: left;
  }

  .package-card {
    background: var(--white);
    border: 1.5px solid color-mix(in srgb, var(--black) 12%, transparent);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .package-card--solo {
    border-top: 3px solid var(--baby-blue-deep);
  }

  .package-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--black);
  }

  .package-tagline {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-bottom: 1.25rem;
    min-height: 2.7em;
  }

  .package-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .package-table th {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    color: var(--baby-blue-deep);
    padding: 0 0.4rem 0.55rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--black) 12%, transparent);
  }

  .package-table td {
    padding: 0.6rem 0.4rem 0.6rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--black) 8%, transparent);
    vertical-align: top;
    line-height: 1.35;
    color: var(--ink);
  }

  .package-table tr:last-child td {
    border-bottom: none;
  }

  .package-tier-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .package-savings {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--baby-blue-deep);
  }

  @media (max-width: 900px) {
    .package-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- PRICING ---------- */
  .plans {
    max-width: 1000px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    text-align: center;
    justify-content: center;
    display: flex;
  }
 .plans > div {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem 1.5rem; /* Mniejszy padding w poziomie, by dopasować do węższej karty */
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  /* Efekt Hover */
  .plans> div:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
  } 

  .practices {
    max-width: 760px; /* Wyraźnie zwężone, by zachować luksusowe proporcje */
    margin: 3rem auto 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem; 
    align-items: stretch;
    padding: 0 1.5rem; 
  }

  /* Styl dla pojedynczego elementu/karty */
  .practices > div {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem 1.5rem; /* Mniejszy padding w poziomie, by dopasować do węższej karty */
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Efekt Hover */
  .practices > div:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
  } 

.plan {
    background: var(--white);
    border: 1.5px solid color-mix(in srgb, var(--black) 14%, transparent);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border-radius: 6px;
  }

  .plan--highlight {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }

  .plan-length {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    opacity: 0.6;
  }

  .plan h3 {
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0.15rem 0 0.1rem;
  }

  .plan-price {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--baby-blue-deep);
    margin-bottom: 0.4rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .plan-price-old {
    font-size: 0.8rem;
    opacity: 0.5;
    text-decoration: line-through;
  }

  .plan--highlight .plan-price {
    color: var(--baby-blue);
  }

  .plan-detail {
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.85;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .plan .cta-primary,
  .plan .cta-ghost {
    text-align: center;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
  }

  .plan--highlight .cta-primary {
    background: var(--baby-blue);
    color: var(--black);
  }

  .plan--highlight .cta-primary:hover {
    background: var(--baby-blue-deep);
  }

  @media (max-width: 780px) {
    .plans {
      grid-template-columns: 1fr;
      flex-direction: column; /* FIX 8: .plans is display:flex, so grid-template-columns never applied; stack cards on mobile */
    }
  }

  /* ---------- LOCATION / MAP ---------- */
  .location-layout {
    max-width: 1080px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.5rem;
    align-items: start;
    text-align: left;
  }

  .location-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .location-info dl {
    margin: 0;
    display: grid;
    row-gap: 0.9rem;
  }

  .location-info dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--baby-blue);
    margin-bottom: 0.15rem;
  }

  .location-info dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--white) 88%, transparent);
  }

  .location-info .cta-primary {
    background: var(--baby-blue);
    color: var(--black);
    width: fit-content;
  }

  .location-info .cta-primary:hover {
    background: var(--baby-blue-deep);
  }

  .location-map {
    border: 2px solid var(--baby-blue);
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .location-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.15) contrast(1.02);
  }

  @media (max-width: 820px) {
    .location-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FINAL CTA BAND ---------- */
  .section--band {
    background: var(--baby-blue);
    color: var(--black);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .section--band :global(.keys.divider) {
    max-width: 480px;
    width: 100%;
  }

  .section--band h2 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }

  .band-sub {
    max-width: 46ch;
    opacity: 0.85;
    line-height: 1.6;
    margin: 0 auto;
  }

  /* ---------- FOOTER ---------- */
  .footer {
    background: var(--black);
    color: color-mix(in srgb, var(--white) 65%, transparent);
    padding: 2rem clamp(1.25rem, 6vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-row p {
    font-size: 0.85rem;
  }

  .footer-fine {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.55;
  }

  .footer-link {
    text-decoration: underline;
    color: inherit;
    opacity: 0.7;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .main-logo {
    max-width: 7%;
    height: auto;
  }
  .footer-logo {
    max-width: 2%;
    height: auto;
  }

  /* ---------- ABOUT / EVENTS ---------- */
  .about {
    max-width: 640px;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .about-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .about-lead strong {
    color: var(--black);
  }

  .about-lead em {
    color: var(--baby-blue-deep);
    font-style: normal;
  }

  .school-events {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: var(--black);
  }

  .school-events li {
    position: relative;
    padding-left: 1.4rem;
  }

  .school-events li::before {
    content: "♪";
    position: absolute;
    left: 0;
    color: var(--baby-blue-deep);
  }

  /* ---------- INQUIRY MODAL ---------- */
  .inquiry-dialog {
    border: none;
    border-radius: 10px;
    padding: 0;
    max-width: 420px;
    width: calc(100% - 2rem);
    color: var(--ink);
    background: var(--white);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.35);
  }

  .inquiry-dialog::backdrop {
    background: color-mix(in srgb, var(--black) 55%, transparent);
  }

  .inquiry-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2rem 1.75rem 1.75rem;
    text-align: left;
  }

  .inquiry-form h3 {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
    padding-right: 1.5rem;
  }

  .inquiry-sub {
    margin: -0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  .inquiry-close {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.2rem;
  }

  .inquiry-close:hover {
    color: var(--black);
  }

  .inquiry-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: none;
    padding: 0;
    margin: 0;
  }

  .inquiry-field input {
    font-family: inherit;
    font-size: 0.95rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
    padding: 0.65rem 0.75rem;
    border: 1.5px solid color-mix(in srgb, var(--black) 16%, transparent);
    border-radius: 5px;
    background: var(--white);
  }

  .inquiry-field textarea {
    font-family: inherit;
    font-size: 0.95rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
    padding: 0.65rem 0.75rem;
    border: 1.5px solid color-mix(in srgb, var(--black) 16%, transparent);
    border-radius: 5px;
    background: var(--white);
    resize: vertical;
  }

  .inquiry-field input:focus,
  .inquiry-field textarea:focus {
    outline: none;
    border-color: var(--baby-blue-deep);
  }

  .inquiry-radios legend {
    padding: 0 0 0.5rem;
  }

  .inquiry-radio {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display, inherit);
    font-size: 0.92rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink);
    padding: 0.15rem 0;
  }

  .inquiry-radio input {
    accent-color: var(--baby-blue-deep);
    width: 16px;
    height: 16px;
  }

  .inquiry-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: inherit;
    font-size: 0.82rem;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink-soft);
  }

  .inquiry-consent input {
    flex-shrink: 0;
    margin-top: 0.2rem;
    accent-color: var(--baby-blue-deep);
    width: 16px;
    height: 16px;
  }

  .inquiry-consent a {
    color: var(--baby-blue-deep);
    text-decoration: underline;
  }

  .inquiry-submit {
    margin-top: 0.4rem;
    width: 100%;
    border: none;
    cursor: pointer;
  }

  /* ---------- FAQ ---------- */
  .faq-list {
    max-width: 640px;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: left;
  }

  .faq-item {
    background: var(--white);
    border: 1.5px solid color-mix(in srgb, var(--black) 12%, transparent);
    border-radius: 8px;
    padding: 0.25rem 1.25rem;
  }

  .faq-item[open] {
    border-color: var(--baby-blue-deep);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-weight: 500;
    font-size: 1rem;
    color: var(--black);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--baby-blue-deep);
    transition: transform 0.15s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    margin: 0 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .faq-ask-btn {
    margin-top: 2rem;
  }

  /* ---------- RODO / PRIVACY POLICY MODAL ---------- */
  .rodo-dialog {
    max-width: 560px;
    max-height: 80vh;
  }

  .rodo-form {
    max-height: 80vh;
    overflow-y: auto;
  }

  .rodo-form h3:first-of-type {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 1.2rem;
    padding-right: 1.5rem;
  }

  .rodo-content {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .rodo-content h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--black);
    margin: 0 0 0.35rem;
  }

  .rodo-content p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
 .toggle-blocks-container {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    justify-content: center;
    width: 100%;
  }

  .toggle-block {
    flex: 1;
    max-width: 350px;
    padding: 20px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    background-color: #ffffff;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    color: #333;
  }

  .toggle-block:hover:not(:disabled) {
    border-color: var(--baby-blue-deep);
    transform: translateY(-2px);
  }

  .toggle-block.active {
    border-color: var(--baby-blue-deep);
    background-color: #f0f7ff;
    cursor: default;
  }

  .toggle-block.active h2 { /* FIX 9: was "h3", but the buttons contain <h2>, so the active title never turned blue */
    color: var(--baby-blue-deep);
  }

  .content-section.hidden {
    display: none !important;
  }

.content-container {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.content-section {
  width: 100%;
}

/* ---------- CLAIRE SPEECH ---------- */
/* FIX 10: these classes were used in the markup but had no styles */
.speech-list,
.speech-quotes {/
  max-width: 50ch;
  margin: 1.5rem auto 0;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  font-size: 1rem;
  line-height: 1.5;
}

.speech-list p { opacity: 0.85; }

.speech-quotes p {
  font-style: italic;
  color: var(--ink-light);
}

.speech-program-details {
  max-width: 700px;
  margin: 2rem auto 0;
