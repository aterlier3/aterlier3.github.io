    <!-- VOUCHER MODAL -->
    <dialog id="voucher-dialog" class="inquiry-dialog">
      <form id="voucher-form" class="inquiry-form">
        <button type="button" class="inquiry-close" aria-label="Zamknij" data-close-voucher>&times;</button>
        <h3>Zamów voucher</h3>
        <p class="inquiry-sub" id="voucher-chosen"></p>
        <input type="hidden" name="voucher" />

        <label class="inquiry-field">
          Imię i nazwisko kupującego
          <input type="text" name="buyerName" required autocomplete="name" />
        </label>

        <label class="inquiry-field">
          Twój e-mail
          <input type="email" name="buyerEmail" required autocomplete="email" />
        </label>

        <label class="inquiry-field">
          Imię obdarowanego
          <input type="text" name="recipientName" required />
        </label>

        <label class="inquiry-field">
          E-mail obdarowanego
          <input type="email" name="recipientEmail" />
        </label>

        <label class="inquiry-field">
          Dedykacja (opcjonalnie)
          <textarea name="message" rows="3"></textarea>
        </label>

        <label class="inquiry-consent">
          <input type="checkbox" name="rodoConsent" required />
          <span>
            Wyrażam zgodę na przetwarzanie moich danych osobowych w celu realizacji zamówienia,
            zgodnie z <a href="#rodo" data-open-rodo>Polityką Prywatności (RODO)</a>.*
          </span>
        </label>

        <button type="submit" class="cta-primary inquiry-submit">Wyślij zamówienie</button>
      </form>
    </dialog>

    <script>
      // Expand offer details inside the clicked voucher card.
      const voucherTiles = document.querySelectorAll<HTMLButtonElement>("[data-voucher-tile]");
      const voucherPanels = document.querySelectorAll<HTMLElement>(".voucher-panel");

      voucherTiles.forEach((tile) => {
        tile.addEventListener("click", () => {
          const id = tile.getAttribute("data-voucher-tile");
          const panel = id ? document.getElementById(`voucher-panel-${id}`) : null;
          if (!panel) return;

          const willOpen = panel.hidden;
          voucherPanels.forEach((item) => (item.hidden = true));
          voucherTiles.forEach((item) => {
            item.classList.remove("active");
            item.setAttribute("aria-expanded", "false");
          });

          if (willOpen) {
            panel.hidden = false;
            tile.classList.add("active");
            tile.setAttribute("aria-expanded", "true");
          }
        });
      });

      // modal + email
      const voucherDialog = document.getElementById("voucher-dialog") as HTMLDialogElement | null;
      const voucherForm = document.getElementById("voucher-form") as HTMLFormElement | null;

      if (voucherDialog && voucherForm) {
        document.querySelectorAll("[data-open-voucher]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const label = btn.getAttribute("data-voucher") || "";
            const hidden = voucherForm.querySelector('input[name="voucher"]') as HTMLInputElement | null;
            const chosen = document.getElementById("voucher-chosen");
            if (hidden) hidden.value = label;
            if (chosen) chosen.textContent = label;
            voucherDialog.showModal();
          });
        });

        document.querySelectorAll("[data-close-voucher]").forEach((btn) => {
          btn.addEventListener("click", () => voucherDialog.close());
        });

        voucherDialog.addEventListener("click", (e) => {
          if (e.target === voucherDialog) voucherDialog.close();
        });

        voucherForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const d = new FormData(voucherForm);
          const subject = `Zamówienie vouchera: ${d.get("voucher")}`;
          const body = [
            `Voucher: ${d.get("voucher")}`,
            `Kupujący: ${d.get("buyerName")} (${d.get("buyerEmail")})`,
            `Obdarowany: ${d.get("recipientName")} (${d.get("recipientEmail") || "brak e-maila"})`,
            "",
            "Dedykacja:",
            String(d.get("message") || "—"),
          ].join("\n");

          window.location.href = `mailto:jachimczak.klara@gmail.com?subject=${encodeURIComponent(
            subject
          )}&body=${encodeURIComponent(body)}`;

          voucherDialog.close();
          voucherForm.reset();
        });
      }
    </script>


