        rodoDialog.addEventListener("click", (event) => {
          if (event.target === rodoDialog) rodoDialog.close();
        });
      }
    </script>

    <!-- INQUIRY MODAL (used by both lesson plans and Claire Practice) -->
    <dialog id="inquiry-dialog" class="inquiry-dialog">
      <form id="inquiry-form" class="inquiry-form">
        <button type="button" class="inquiry-close" aria-label="Zamknij" data-close-inquiry>&times;</button>
        <h3>Zarezerwuj termin</h3>
        <p class="inquiry-sub">
          Wybierz pakiet i zostaw swoje dane — odezwiemy się, żeby ustalić szczegóły.
        </p>

        <fieldset class="inquiry-field inquiry-radios">
          <legend>CLAIRE PIANO</legend>
          {plans.map((plan) => (
            <label class="inquiry-radio">
              <input type="radio" name="package" value={plan.name} required />
              {plan.name} — {plan.length} / {plan.price}
            </label>
          ))}
        </fieldset>

        <fieldset class="inquiry-field inquiry-radios">
          <legend>Practice</legend>
          {practies.map((plan) => (
            <label class="inquiry-radio">
              <input type="radio" name="package" value={plan.name} required />
              {plan.name} — {plan.length} / {plan.price}
            </label>
          ))}
        </fieldset>

        <fieldset class="inquiry-field inquiry-radios">
          <legend>Claire Speech</legend>
          {speechPackages.map((p) => (
            <label class="inquiry-radio">
              <input type="radio" name="package" value={p.name} required />
              {p.name} — {p.length} / {p.price}
            </label>
          ))}
        </fieldset>

        <label class="inquiry-field">
          Imię i nazwisko
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label class="inquiry-field">
          Adres e-mail
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="inquiry-field">
          Numer telefonu
          <input type="tel" name="phone" autocomplete="tel" />
        </label>

        <label class="inquiry-consent">
          <input type="checkbox" name="rodoConsent" required />
          <span>
            Wyrażam zgodę na przetwarzanie moich danych osobowych w celu obsługi zapytania,
            zgodnie z <a href="#rodo" data-open-rodo>Polityką Prywatności (RODO)</a>.*
          </span>
        </label>

        <button type="submit" class="cta-primary inquiry-submit">Wyślij zapytanie</button>
      </form>
    </dialog>

    <script>
      const dialog = document.getElementById("inquiry-dialog") as HTMLDialogElement | null;
      const form = document.getElementById("inquiry-form") as HTMLFormElement | null;

      if (dialog && form) {
        document.querySelectorAll("[data-open-inquiry]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const pkg = btn.getAttribute("data-package");
            const radio = form.querySelector<HTMLInputElement>(
              `input[name="package"][value="${pkg}"]`
            );
            if (radio) radio.checked = true;
            dialog.showModal();
          });
        });

        document.querySelectorAll("[data-close-inquiry]").forEach((btn) => {
          btn.addEventListener("click", () => dialog.close());
        });

        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const pkg = data.get("package");
          const name = data.get("name");
          const email = data.get("email");
          const phone = data.get("phone");

          const subject = `Zapytanie: ${pkg}`;
          const body = [
            `Pakiet: ${pkg}`,
            `Imię i nazwisko: ${name}`,
            `E-mail: ${email}`,
            `Telefon: ${phone}`,
            "",
            "Proszę o kontakt w sprawie wybranego pakietu.",
          ].join("\n");

          window.location.href = `mailto:jachimczak.klara@gmail.com?subject=${encodeURIComponent(
            subject
          )}&body=${encodeURIComponent(body)}`;

          dialog.close();
          form.reset();
        });
      }
    </script>

