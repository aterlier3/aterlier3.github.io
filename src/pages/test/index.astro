<script>
  function initToggle() {
    const blocks = document.querySelectorAll('.toggle-block') as NodeListOf<HTMLButtonElement>;
    const sections = document.querySelectorAll('.content-section') as NodeListOf<HTMLElement>;

    blocks.forEach((clickedBlock) => {
      clickedBlock.addEventListener('click', (e) => {
        e.preventDefault();

        const targetSelector = clickedBlock.getAttribute('data-target');
        if (!targetSelector) return;

        // Resetowanie stanów kafelków i sekcji
        blocks.forEach((block) => {
          block.classList.remove('active');
          block.disabled = false;
        });
        sections.forEach((section) => {
          section.classList.add('hidden');
        });

        // Aktywacja wybranego kafelka i sekcji
        clickedBlock.classList.add('active');
        clickedBlock.disabled = true;

        const targetSection = document.querySelector(targetSelector);
        if (targetSection) {
          targetSection.classList.remove('hidden');
        }
      });
    });
  }

  // Uruchomienie skryptu przy ładowaniu strony i wsparcie dla View Transitions
  initToggle();
  document.addEventListener('astro:page-load', initToggle);
</script>

